# Server only. Never use VITE_ prefixes for credentials.
OPENAI_API_KEY=
OPENAI_MODEL=chat-latest
# Legacy ASTRA_MODEL is still supported as an explicit override.
ASTRA_MAX_OUTPUT_TOKENS=1200
ASTRA_REQUESTS_PER_MINUTE=10
ASTRA_DAILY_REQUEST_LIMIT=100
# Production requires persistent limits; missing configuration fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated exact deployment origins and installed extension ID, if needed.
ASTRA_ALLOWED_ORIGINS=https://tail-solana-workspace.vercel.app
# Optional usage estimate: use the exact returned provider model ID and explicit
# current owner rates. Leave blank to report monetary cost as unknown.
ASTRA_PRICE_MODEL=
ASTRA_INPUT_USD_PER_MILLION=
ASTRA_OUTPUT_USD_PER_MILLION=
# X search/history and live SPL deployment are not implemented or enabled.

# Optional frontend opt-in to the separate read-only Backend V1.
# npm run dev:backend sets this locally without affecting production builds.
# VITE_TAIL_API_URL=/tail-api
# TAIL_BACKEND_URL=http://127.0.0.1:8787
# Provider secrets for V1 belong in backend/tail-v1/.env, not in VITE_ variables.

# npm run dev/build and packaged extension default to standalone public-source mode.
# An explicit VITE_TAIL_API_URL selects server V1 instead. No public server is inferred.
# VITE_TAIL_STANDALONE=1
