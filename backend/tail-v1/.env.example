# Duplicate this file as .env. Do not commit .env.
PORT=8787
HOST=127.0.0.1
# Comma separated exact origins. No wildcard for production.
ALLOWED_ORIGINS=http://localhost:4664,http://localhost:5173
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_BACKUP_URL=
JUPITER_API_KEY=
# Fable calls the real OpenAI Responses API when OPENAI_API_KEY is configured; the model defaults to chat-latest.
OPENAI_API_KEY=
OPENAI_MODEL=chat-latest
# Place local anonymous watchlist data in ./data (not a wallet-auth system).
DATA_DIR=./data
MAX_STREAM_TOKENS=12
MARKET_POLL_MS=10000
